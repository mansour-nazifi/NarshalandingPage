<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.1.2.1" />
    <PackageReference Include="WebMarkupMin.Core" Version="2.13.0" />
  </ItemGroup>

  <Target Name="BuildAssets" AfterTargets="Build">
    <Exec Command="npm run build:assets" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
