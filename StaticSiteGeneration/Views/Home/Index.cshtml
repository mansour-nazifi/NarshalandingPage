@model NarshaStaticSite.ViewModels.HomeViewModel
@{
    }
<!-- ============ HERO SECTION ============ -->
<section class="hero position-relative d-flex align-items-center overflow-hidden py-5" id="hero" aria-labelledby="hero-title">
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7 hero-text text-center text-lg-start px-3 px-lg-0">
                <span class="hero-badge d-inline-block mb-4 py-2 px-3" aria-hidden="true">مزون دوخت سفارشی نارشا • اردبیل</span>
                <h1 id="hero-title" class="hero-title mb-4">
                    <span class="hero-title-line">دوخت سفارشی لباس زنانه</span>
                    <span class="hero-title-line gold">متناسب با اندازه و انتخاب شما</span>
                </h1>
                <p class="hero-subtitle mx-auto mx-lg-0 mb-4">
                    در مزون نارشا، مدل و پارچه با توجه به کاربرد لباس و سفارش شما بررسی می‌شود؛ سپس اندازه‌گیری، الگو و دوخت بر همان اساس پیش می‌روند. از مانتو و کت تا دامن، شلوار و لباس مجلسی.
                </p>
                <div class="hero-buttons d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mb-0">
                    <a href="@SiteRoutes.ContactUs" class="btn btn-gold">مشاوره و ثبت سفارش <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg></a>
                    <a href="@SiteRoutes.CustomSewing" class="btn btn-outline-gold">دوخت سفارشی <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg></a>
                </div>
            </div>
            <div class="col-lg-5 hero-visual d-flex align-items-center justify-content-center">
                <div class="hero-image-wrapper position-relative overflow-hidden">
                    <img src="/images/hero-2.webp" alt="نمونه لباس زنانه دوخته‌شده به‌صورت سفارشی در مزون نارشا اردبیل" class="hero-image" width="800" height="1200" loading="eager" fetchpriority="high">
                    <div class="hero-image-frame"></div>
                    <div class="hero-image-glow"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ ABOUT SECTION ============ -->
<section class="py-5 section-dark" id="about" aria-labelledby="about-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "درباره مزون نارشا",
            "مبنای کار ما",
            "الگو، تناسب و جزئیات دوخت",
            TitleId: "about-title"))
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6">
                <div class="about-images position-relative reveal-element">
                    <div class="about-img-main">
                        <div class="card-image-wrap">
                            <img src="/images/about.webp" alt="فضای داخلی مزون نارشا، مزون دوخت سفارشی لباس زنانه در اردبیل" class="img-fluid w-100" width="600" height="400" loading="lazy">
                        </div>
                    </div>
                    <div class="about-img-secondary">
                        <img src="/images/about-secondary.webp" alt="جزئیات دوخت، برش و اجرای الگو در مزون نارشا اردبیل" class="img-fluid w-100" width="600" height="400" loading="lazy">
                    </div>
                    <div class="about-experience-badge p-3">
                        <span class="badge-number d-block">نارشا</span>
                        <span class="badge-text d-block mt-1">مزون طراحی و دوخت سفارشی لباس زنانه در اردبیل</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-content reveal-element">
<h3 class="about-heading mb-3">دوخت سفارشی با توجه به مدل، پارچه و اندازه‌های شما</h3>
<p class="about-text mb-3">نارشا مزون طراحی و دوخت سفارشی پوشاک زنانه در اردبیل است. هر سفارش با گفت‌وگو درباره کاربرد لباس و مدل موردنظر آغاز می‌شود؛ سپس پارچه، اندازه‌ها و جزئیات اجرایی برای آماده‌سازی الگو و دوخت بررسی می‌شوند.</p>
<p class="about-text mb-3">در لباس‌هایی مانند کت و پالتو، تناسب سرشانه، یقه و آستین اهمیت دارد؛ در شومیز، دامن و شلوار نیز فرم برش و اندازه‌ها در تن‌خور نهایی نقش دارند. همین جزئیات مبنای تصمیم‌گیری در مسیر اجرای سفارش‌اند.</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4 12.5-12.5z" /></svg></div><div><strong class="d-block mb-1">الگو بر مبنای سفارش</strong><p class="mb-0">مدل و اندازه‌های لازم برای هر لباس در زمان مشاوره بررسی می‌شود.</p></div></div>
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12l4 5-10 13L2 8l4-5z" /><path d="M2 8h20" /></svg></div><div><strong class="d-block mb-1">انتخاب پارچه و جزئیات</strong><p class="mb-0">تناسب پارچه با فرم لباس و جزئیات اجرایی پیش از برش بررسی می‌شود.</p></div></div>
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></div><div><strong class="d-block mb-1">هماهنگی روند سفارش</strong><p class="mb-0">جزئیات اجرا، زمان آماده‌سازی و شیوه تحویل هنگام ثبت سفارش هماهنگ می‌شود.</p></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ CUSTOM SEWING SECTION ============ -->
@await Component.InvokeAsync("CustomSewingCategoryList")

<!-- ============ SERVICES SECTION ============ -->
<section class="py-5 section-dark" id="services" aria-labelledby="services-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "خدمات مزون",
            "خدمات",
            "دوخت و طراحی",
            TitleEnd: "در مزون نارشا",
            Description: "از انتخاب مدل و بررسی پارچه تا اندازه‌گیری، دوخت و تحویل؛ خدمات مزون نارشا برای سفارش‌های پوشاک زنانه در اردبیل و هماهنگی غیرحضوری ارائه می‌شود.",
            TitleId: "services-title"))
        @await Component.InvokeAsync("ServiceCardList", new { items = NarshaStaticSite.Data.HomeData.Services(), numbered = false })
    </div>
</section>

<!-- ============ PORTFOLIO SECTION ============ -->
<section class="py-5" id="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "نمونه‌کارها",
            "منتخب",
            "نمونه‌های دوخت",
            TitleEnd: "مزون نارشا",
            Description: "نگاهی به نمونه‌های نمایش‌داده‌شده از پوشاک زنانه و دوخت مزون نارشا؛ برای بررسی امکان سفارش مدلی مشابه، با مزون تماس بگیرید.",
            TitleId: "portfolio-title"))
        <div class="row row-cols-2 row-cols-lg-3 g-3">
            @foreach (var item in NarshaStaticSite.Data.HomeData.PortfolioItems())
            {
                @await Component.InvokeAsync("PortfolioItem", new { item = item, index = item.Index })
            }
        </div>
        <div class="text-center mt-4 reveal-element">
            <p class="fs-5 mb-4">برای پرسش درباره مدل‌ها، پارچه و شرایط سفارش با مزون نارشا در ارتباط باشید.</p>
            <a href="@SiteRoutes.ContactUs" class="btn btn-gold mt-2">تماس و مشاوره درباره سفارش</a>
        </div>
        @await Component.InvokeAsync("Lightbox", NarshaStaticSite.Data.HomeData.PortfolioItems())
    </div>
</section>

