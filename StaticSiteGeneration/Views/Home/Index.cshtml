@model NarshaStaticSite.ViewModels.HomeViewModel
@{
    }
<!-- ============ HERO SECTION ============ -->
<section class="hero position-relative d-flex align-items-center overflow-hidden py-5" id="hero" aria-labelledby="hero-title">
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative">
        <div class="row align-items-center gy-5">
            <div class="col-lg-7 hero-text text-center text-lg-start px-3 px-lg-0">
                <span class="hero-badge d-inline-block mb-4 py-2 px-3" aria-hidden="true">مزون نارشا • اردبیل</span>
                <h1 id="hero-title" class="hero-title mb-4">
                    <span class="hero-title-line">لباسی که برای شما دوخته می‌شود</span>
                    <span class="hero-title-line gold">نه برای همه</span>
                </h1>
                <p class="hero-subtitle mx-auto mx-lg-0 mb-4">
                    از اندازه‌گیری تا تحویل، هر مرحله با دقت و توجه به فرم اندام شما پیش می‌رود.
                    لباس عروس، مجلسی، مانتو، کت و پالتو — همه سفارشی.
                </p>
                <div class="hero-buttons d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mb-0">
                    <a href="@SiteRoutes.ContactUs" class="btn btn-gold">رزرو مشاوره و ثبت سفارش <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg></a>
                    <a href="@SiteRoutes.CustomSewing" class="btn btn-outline-gold">دوخت سفارشی <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg></a>
                </div>
            </div>
            <div class="col-lg-5 hero-visual d-flex align-items-center justify-content-center">
                <div class="hero-image-wrapper position-relative overflow-hidden">
                    <img src="/images/hero-2.webp" alt="نمونه لباس زنانه دوخته‌شده به‌صورت سفارشی در مزون نارشا اردبیل" class="hero-image" width="800" height="1200" loading="eager" fetchpriority="high">
                    <div class="hero-image-frame"></div>
                    <div class="hero-image-glow"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ ABOUT SECTION ============ -->
<section class="py-5 section-dark" id="about" aria-labelledby="about-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "درباره مزون نارشا",
            "دوخت سفارشی با تکیه بر",
            "تناسب، فیت و جزئیات",
            TitleId: "about-title"))
        <div class="row align-items-center g-4 g-lg-5">
            <div class="col-lg-6">
                <div class="about-images position-relative reveal-element">
                    <div class="about-img-main">
                        <div class="card-image-wrap">
                            <img src="/images/about.webp" alt="فضای داخلی مزون نارشا، مزون دوخت سفارشی لباس زنانه در اردبیل" class="img-fluid w-100" width="600" height="400" loading="lazy">
                        </div>
                    </div>
                    <div class="about-img-secondary">
                        <img src="/images/about-secondary.webp" alt="جزئیات دوخت، برش و اجرای الگو در مزون نارشا اردبیل" class="img-fluid w-100" width="600" height="400" loading="lazy">
                    </div>
                    <div class="about-experience-badge p-3">
                        <span class="badge-number d-block">10+</span>
                        <span class="badge-text d-block mt-1">سال تجربه در دوخت سفارشی و طراحی لباس در اردبیل</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-content reveal-element">
<h3 class="about-heading mb-3">مزونی برای بانوانی که به برش دقیق، ایستایی لباس و کیفیت دوخت اهمیت می‌دهند</h3>
<p class="about-text mb-3">مزون نارشا در اردبیل با تمرکز بر دوخت سفارشی لباس زنانه، هر سفارش را بر اساس فرم بدن، کاربرد لباس و سبک شخصی شما پیش می‌برد. از انتخاب مدل و پارچه تا الگوسازی، برش، دوخت و فیت نهایی، هر مرحله با دقت انجام می‌شود.</p>
<p class="about-text mb-3">ما باور داریم لباس خوب نتیجه هماهنگی تناسب اندام، متریال مناسب و جزئیات تمیز دوخت است؛ از دوخت تمیز سجاف و آستین تا نظم در آسترکشی و اتوکشی.</p>
                    <div class="d-flex flex-column gap-3 mt-4">
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4 12.5-12.5z" /></svg></div><div><strong class="d-block mb-1">الگو و دوخت اختصاصی</strong><p class="mb-0">طراحی و اجرا بر اساس اندازه‌ها، فرم اندام و نیاز واقعی شما انجام می‌شود.</p></div></div>
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12l4 5-10 13L2 8l4-5z" /><path d="M2 8h20" /></svg></div><div><strong class="d-block mb-1">کیفیت در جزئیات</strong><p class="mb-0">تمرکز بر انتخاب پارچه مناسب، برش تمیز و دقت در دوخت و تکمیل کار.</p></div></div>
                        <div class="value-item d-flex align-items-start gap-3 p-3"><div class="value-icon d-flex align-items-center justify-content-center flex-shrink-0" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg></div><div><strong class="d-block mb-1">همراهی تا تحویل</strong><p class="mb-0">از مشاوره و اندازه‌گیری تا پرو، اصلاحات لازم و تحویل نهایی در کنار شما هستیم.</p></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ CUSTOM SEWING SECTION ============ -->
@await Component.InvokeAsync("CustomSewingCategoryList")

<!-- ============ SERVICES SECTION ============ -->
<section class="py-5 section-dark" id="services" aria-labelledby="services-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "خدمات مزون",
            "خدمات",
            "دوخت و طراحی",
            TitleEnd: "در مزون نارشا",
            Description: "خدمات مزون نارشا بر پایه دوخت سفارشی، تناسب اندام و اجرای تمیز شکل گرفته است؛ از مشاوره اولیه تا تحویل لباسی که مطابق نیاز و سلیقه شما دوخته شده باشد.",
            TitleId: "services-title"))
        @await Component.InvokeAsync("ServiceCardList", new { items = NarshaStaticSite.Data.HomeData.Services(), numbered = false })
    </div>
</section>

<!-- ============ PORTFOLIO SECTION ============ -->
<section class="py-5" id="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "نمونه‌کارها",
            "منتخب",
            "نمونه‌های دوخت",
            TitleEnd: "مزون نارشا",
            Description: "بخشی از کارهای اجراشده در مزون نارشا؛ نمونه‌هایی از دوخت سفارشی با تمرکز بر تناسب اندام، انتخاب پارچه و جزئیات اجرا.",
            TitleId: "portfolio-title"))
        <div class="row row-cols-2 row-cols-lg-3 g-3">
            @foreach (var item in NarshaStaticSite.Data.HomeData.PortfolioItems())
            {
                @await Component.InvokeAsync("PortfolioItem", new { item = item, index = item.Index })
            }
        </div>
        <div class="text-center mt-4 reveal-element">
            <p class="fs-5 mb-4">برای دیدن مدل‌های بیشتر یا ثبت سفارش دوخت سفارشی، با مزون نارشا در تماس باشید.</p>
            <a href="@SiteRoutes.ContactUs" class="btn btn-gold mt-2">مشاوره و ثبت سفارش</a>
        </div>
        @await Component.InvokeAsync("Lightbox", NarshaStaticSite.Data.HomeData.PortfolioItems())
    </div>
</section>

