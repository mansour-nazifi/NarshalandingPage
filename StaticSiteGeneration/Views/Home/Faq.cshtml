@model NarshaStaticSite.ViewModels.FaqPageViewModel
<div class="container">
    @await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
    {
        new BreadcrumbItem("صفحه اصلی", SiteRoutes.Home),
        new BreadcrumbItem("پرسش‌های متداول")
    })
</div>
<section class="category-hero position-relative d-flex align-items-center py-5" aria-labelledby="faq-hero-title">
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative text-center">
        <span class="hero-badge d-inline-block mb-4 py-2 px-3" aria-hidden="true">راهنما و پاسخ سوالات</span>
        <h1 id="faq-hero-title" class="hero-title mb-3">
            <span class="hero-title-line">پرسش‌های متداول</span>
            <span class="hero-title-line gold">درباره دوخت سفارشی</span>
        </h1>
        <p class="hero-subtitle mx-auto mb-4">پاسخ چند پرسش متداول درباره روند سفارش، زمان‌بندی، هزینه و شرایط دوخت در مزون نارشا. برای جزئیات سفارش خود می‌توانید مستقیماً تماس بگیرید.</p>
        <div class="hero-buttons d-flex flex-wrap justify-content-center gap-3 mt-4 mb-0">
            <a href="#faq" class="btn btn-gold">مشاهده سوالات <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg></a>
            <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-gold">مشاوره در بله <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></a>
        </div>
    </div>
</section>
<section class="py-5" id="faq" aria-labelledby="faq-hero-title" itemscope itemtype="https://schema.org/FAQPage">
    <div class="container">
        @await Component.InvokeAsync("FaqGrid", Model.Items)
    </div>
</section>