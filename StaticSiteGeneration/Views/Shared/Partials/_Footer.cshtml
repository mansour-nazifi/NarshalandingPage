@model bool
@{
    var isHome = Model;
    string H(string hash) => isHome ? hash : "/" + hash;
}
<footer class="site-footer pt-5" id="footer" role="contentinfo">
    <div class="container">
        <div class="row g-4 pb-4 border-bottom border-secondary-subtle">
            <div class="col-12 col-lg-4">
                <a href="@(isHome?"#hero":SiteRoutes.Home)" class="footer-logo d-inline-block mb-3" aria-label="مزون نارشا — بازگشت به صفحه اصلی">
                    <div class="logo-wrapper">
                        <div class="logo-text">
                            <span class="logo-brand">نارشا</span>
                        </div>
                    </div>
                </a>
                <p class="footer-desc mb-3">مزون نارشا در اردبیل، ارائه‌دهنده خدمات دوخت سفارشی لباس زنانه شامل کت، مانتو، پالتو، شومیز، دامن، شلوار و لباس شب و مجلسی؛ با تمرکز بر تناسب اندام، کیفیت دوخت و همراهی در مراحل سفارش.</p>
                <div class="footer-social d-flex flex-wrap align-items-center">
                    <a href="@SiteContact.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="اینستاگرام مزون نارشا">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="5" /><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none" /></svg>
                    </a>
                    <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" aria-label="بله مزون نارشا">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    </a>
                    <a href="@SiteContact.TelHref" aria-label="تماس تلفنی با مزون نارشا">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
                    </a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h2 class="footer-heading h5 mb-3 pb-2">دسترسی سریع</h2>
                <ul class="footer-links list-unstyled mb-0">
                    <li class="mb-2"><a href="@H("#hero")">خانه</a></li>
                    <li class="mb-2"><a href="@H("#about")">درباره ما</a></li>
                    <li class="mb-2"><a href="@H("#services")">خدمات</a></li>
                    <li class="mb-2"><a href="@SiteRoutes.CustomSewing">دوخت سفارشی</a></li>
                    <li class="mb-2"><a href="@H("#portfolio")">نمونه‌کارها</a></li>
                    <li class="mb-2"><a href="@SiteRoutes.PaymentMethods">روش‌های پرداخت</a></li>
                    <li class="mb-2"><a href="@SiteRoutes.Faq">پرسش‌های متداول</a></li>
                    <li class="mb-2"><a href="@SiteRoutes.ContactUs">تماس با ما</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-3">
                <h2 class="footer-heading h5 mb-3 pb-2">خدمات مزون اردبیل</h2>
                <ul class="footer-links list-unstyled mb-0">
                    <li class="mb-2"><a href="@H("#services")">لباس مجلسی و شب</a></li>
                    <li class="mb-2"><a href="@H("#services")">مانتو و پوشاک سفارشی</a></li>
                    <li class="mb-2"><a href="@H("#services")">لباس عروس و نامزدی</a></li>
                    <li class="mb-2"><a href="@H("#services")">سایزگیری و فیتینگ تخصصی</a></li>
                    <li class="mb-2"><a href="@H("#services")">مشاوره استایل و انتخاب پارچه</a></li>
                    <li class="mb-2"><a href="@H("#services")">طراحی اختصاصی لباس</a></li>
                </ul>
            </div>
            <div class="col-12 col-lg-3">
                <h2 class="footer-heading h5 mb-3 pb-2">اطلاعات تماس</h2>
                <ul class="footer-contact list-unstyled mb-0">
                    <li class="d-flex align-items-center gap-2 mb-2">
                        <svg class="flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>@SiteContact.Address</span>
                    </li>
                    <li class="d-flex align-items-center gap-2 mb-2">
                        <svg class="flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67 A2 2 0 0 1 4.11 2h3 a2 2 0 0 1 2 1.72 c.12.81.33 1.6.61 2.36 a2 2 0 0 1-.45 2.11L8.09 9.91 a16 16 0 0 0 6 6 l1.72-1.18 a2 2 0 0 1 2.11-.45 c.76.28 1.55.49 2.36.61 A2 2 0 0 1 22 16.92z" /></svg>
                        <a href="@SiteContact.TelHref" aria-label="تماس تلفنی با مزون نارشا"><span dir="ltr">@SiteContact.PhoneDisplay</span></a>
                    </li>
                    <li class="d-flex align-items-center gap-2 mb-2">
                        <svg class="flex-shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                        <span>@SiteContact.Hours</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom d-flex flex-column flex-md-row justify-content-md-between align-items-center gap-2 text-center text-md-start py-3">
            <p class="mb-0">© 1405 مزون نارشا — تمامی حقوق محفوظ است</p>
            <p class="footer-tagline mb-0">طراحی شده برای زیبایی‌های ماندگار</p>
        </div>
    </div>
</footer>