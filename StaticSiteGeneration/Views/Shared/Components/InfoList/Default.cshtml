@model IReadOnlyList<NarshaStaticSite.Models.InfoItem>
<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var item in Model)
    {
        <div class="col d-flex">
            <div class="info-item d-flex align-items-start gap-3 h-100 w-100 p-3">
                <div class="info-icon flex-shrink-0 d-flex align-items-center justify-content-center" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gold"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10" stroke-width="2"></polyline></svg>
                </div>
                <div class="info-content">
                    <strong class="d-block mb-1">@item.Title</strong>
                    <p class="mb-0">@item.Text</p>
                </div>
            </div>
        </div>
    }
</div>