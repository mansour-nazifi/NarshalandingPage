<section class="py-5" id="custom-sewing" aria-labelledby="custom-sewing-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            "دسته‌بندی‌های دوخت سفارشی",
            "انتخاب دسته‌بندی",
            "دوخت سفارشی",
            Description: "برای شروع سفارش، دسته‌بندی لباس موردنظر خود را انتخاب کنید. در هر بخش مدل‌ها، جزئیات دوخت و گزینه‌های اجرایی مربوط به همان لباس را می‌توانید مشاهده کنید.",
            TitleId: "custom-sewing-title"))
        <div class="row row-cols-2 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var c in NarshaStaticSite.Data.SiteData.Categories())
            {
                <div class="col d-flex reveal-element">
                    <article class="card narsha-card h-100 w-100 position-relative">
                        <div class="card-image-wrap">
                            <img src="@c.Image" alt="دوخت سفارشی @c.SingularName زنانه در مزون نارشا اردبیل" class="card-img-top img-fluid w-100" width="400" height="533" loading="lazy">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h5 mb-0"><a href="/@c.Slug" class="stretched-link text-reset text-decoration-none">@c.SingularName</a></h3>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>