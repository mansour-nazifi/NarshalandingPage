@model NarshaStaticSite.ViewModels.CategoryPageViewModel
@{
    var c = Model.Category;
    var faqHeader = new NarshaStaticSite.Models.SectionHeaderData(
        "سوال‌های رایج",
        "پرسش‌های متداول درباره",
        c.FaqTitleGold,
        TitleId: "faq-title");
    var processHeader = new NarshaStaticSite.Models.SectionHeaderData(
        "روند سفارش",
        "مراحل دوخت",
        c.ProcessTitleGold,
        TitleId: "order-process-title");
    var processItems = c.ProcessSteps.Select(s => new NarshaStaticSite.Models.ServiceItem(s.Title, s.Text, string.Empty)).ToList();
    var otherCats = NarshaStaticSite.Data.SiteData.Categories().Where(x => x.Slug != c.Slug).ToList();
}
<div class="container">
    @await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
    {
        new BreadcrumbItem("صفحه اصلی", SiteRoutes.Home),
        new BreadcrumbItem(c.SingularName)
    })
</div>
<section class="category-hero position-relative d-flex align-items-center py-5" aria-labelledby="category-title">
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>
    <div class="container position-relative text-center">
        <span class="hero-badge d-inline-block mb-4 py-2 px-3" aria-hidden="true">@c.HeroBadge</span>
        <h1 id="category-title" class="hero-title mb-3">
            <span class="hero-title-line">@c.HeroTitleLine1</span>
            <span class="hero-title-line gold">@c.HeroTitleLine2</span>
        </h1>
        <p class="hero-subtitle mx-auto mb-4">@c.HeroSubtitle</p>
        <div class="hero-buttons d-flex flex-wrap justify-content-center gap-3 mt-4 mb-0">
            <a href="#products" class="btn btn-gold">دیدن مدل‌های @c.SingularName</a>
            <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-gold category-bale-btn" data-category="@c.SingularName">مشاوره در بله <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></a>
        </div>
    </div>
</section>
<section class="py-5" id="products" aria-labelledby="products-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", new NarshaStaticSite.Models.SectionHeaderData(
            c.ProductsTag,
            c.ProductsTitle,
            c.ProductsTitleGold,
            Description: c.ProductsDesc,
            TitleId: "products-title"))
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var p in Model.Products)
            {
                <div class="col d-flex reveal-element">
                    <article class="card narsha-card product-list-card h-100 w-100 d-flex flex-row flex-sm-column position-relative">
                        <div class="card-image-wrap">
                            <img src="@p.Image" alt="@p.Alt" class="card-img-top product-list-img img-fluid" width="400" height="533" loading="lazy">
                        </div>
                        <div class="card-body d-flex flex-column flex-grow-1">
                            <h3 class="card-title h5 mb-2"><a href="/@p.Slug" class="stretched-link text-reset text-decoration-none">@p.Title</a></h3>
                            <p class="product-list-desc d-block d-sm-none mb-2">@p.Description</p>
                            <div class="mt-auto">
                                <p class="price-tag mb-0 py-2 px-3">از @NarshaStaticSite.Models.PriceFormat.Toman(p.BasePrice) تومان</p>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>
<section class="py-5  section-dark" id="category-info" aria-labelledby="category-info-title">
    <div class="container">
        <h2 id="category-info-title" class="info-section-title d-flex align-items-center gap-3 mb-4">نکات مهم پیش از سفارش @c.SingularName</h2>
        @await Component.InvokeAsync("InfoList", c.ImportantNotes)
        <div class="mt-4">
            <p class="text-secondary mb-2">دسته‌های دیگر دوخت سفارشی:</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var oc in otherCats)
                {
                    <a href="/@oc.Slug" class="btn btn-outline-gold btn-sm">@oc.PluralName</a>
                }
            </div>
        </div>
    </div>
</section>
@await Html.PartialAsync("Partials/_FaqSection", (faqHeader, c.Faqs, "faq", "py-5"))

<section class="py-5  section-dark" id="order-process" aria-labelledby="order-process-title">
    <div class="container">
        @await Component.InvokeAsync("SectionHeader", processHeader)
        @await Component.InvokeAsync("ServiceCardList", new { items = processItems, numbered = true })
    </div>
</section>

<section class="py-5" id="cta" aria-labelledby="cta-title">
    <div class="container cta-section text-center mx-auto">
        <h2 id="cta-title" class="section-title mb-3">@c.CtaTitle <span class="text-gold">برای جزئیات سفارش</span></h2>
        <div class="section-line mx-auto mb-3" aria-hidden="true"></div>
        <p class="cta-section-desc mb-4">@c.CtaDesc</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="#products" class="btn btn-gold">انتخاب مدل @c.SingularName <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg></a>
            <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-gold category-bale-btn" data-category="@c.SingularName">مشاوره در بله <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></a>
        </div>
    </div>
</section>