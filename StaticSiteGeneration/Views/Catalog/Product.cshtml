@model NarshaStaticSite.ViewModels.ProductPageViewModel
@using System.Text.Json
@using NarshaStaticSite.Data
@{
    var p = Model.Product;
    var c = Model.Category;
    var optsJson = JsonSerializer.Serialize(p.Options.Select(o => new { id = o.Id, name = o.Name, price = o.Price, mandatory = o.Mandatory }));
    var faqHeader = new NarshaStaticSite.Models.SectionHeaderData(
        "سوال‌های رایج",
        "پرسش‌های متداول درباره",
        p.Title,
        TitleId: "faq-title");
    var productFaqs = ProductFaqFactory.For(p);
}
<div class="container">
    @await Component.InvokeAsync("Breadcrumb", new List<BreadcrumbItem>
    {
        new BreadcrumbItem("صفحه اصلی", SiteRoutes.Home),
        new BreadcrumbItem(c.SingularName, $"/{c.Slug}"),
        new BreadcrumbItem(p.Title)
    })
</div>
<section class="py-4" aria-labelledby="product-title">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-6">
                <div class="product-gallery">
                    <img src="@p.Image" alt="@p.Title دوخت سفارشی در مزون نارشا اردبیل" class="product-main-image img-fluid w-100 h-auto d-block" width="600" height="800" loading="eager" fetchpriority="high">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="product-info">
                    <span class="product-category d-block mb-2">@p.CategoryName</span>
                    <h1 id="product-title" class="product-title mb-3">@p.Title</h1>
                    <p class="product-desc mb-4">@p.HeroDescription</p>
                    <div class="price-calculator p-4 mb-4" data-price-calculator data-base-price="@p.BasePrice" data-product-name="@p.DataProductName" data-options='@Html.Raw(optsJson)'>
                            <h2 class="price-calculator-title h2 mb-3 pb-3">محاسبه هزینه شروع دوخت</h2>
                        <div class="price-rows">
                            <div class="price-row d-flex align-items-center justify-content-between py-2">
                                <span class="price-label">هزینه پایه دوخت</span>
                                <span class="price-value price-base">@NarshaStaticSite.Models.PriceFormat.Toman(p.BasePrice)</span>
                            </div>
                            <div class="price-options d-flex flex-column gap-2">
                            @foreach (var o in p.Options)
                            {
                                <label class="option-label py-2 px-3">
                                    <input type="checkbox" class="option-checkbox" id="@o.Id" name="@o.Id" @(o.Mandatory ? "checked disabled" : "") data-name="@o.Name" data-price="@o.Price" data-mandatory="@o.Mandatory">
                                    <span class="option-name">@o.Name</span>
                                    @if (o.Price > 0) { <span class="option-price">+ @NarshaStaticSite.Models.PriceFormat.Toman(o.Price)</span> }
                                    @if (o.Mandatory) { <span class="option-mandatory px-2 py-1">الزامی</span> }
                                </label>
                            }
                            </div>
                            <div class="price-row total d-flex align-items-center justify-content-between mt-2 pt-3">
                                <span class="price-label">مجموع هزینه شروع</span>
                                <span class="price-value price-total-value">@NarshaStaticSite.Models.PriceFormat.Toman(p.BasePrice)</span>
                            </div>
                        </div>
                        <p class="price-disclaimer mb-0 mt-3 p-3">قیمت‌های درج‌شده هزینه شروع دوخت هستند و شامل قیمت پارچه, آستر و ملزومات نمی‌شوند. تهیه پارچه و لوازم برعهده مشتری است. هزینه نهایی پس از بررسی سفارش اعلام می‌شود.</p>
                    </div>
                    <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-bale d-inline-flex align-items-center justify-content-center gap-3 w-100 mt-2 py-3 px-4">
                        مشاوره و استعلام قیمت در بله
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="py-5 section-dark" id="price-factors" aria-labelledby="price-factors-title">
    <div class="container">
        <h2 id="price-factors-title" class="info-section-title d-flex align-items-center gap-3 mb-4">پیش از سفارش @p.Title</h2>
        @await Component.InvokeAsync("InfoList", new List<NarshaStaticSite.Models.InfoItem>
        {
            new("ویژگی مدل", p.FeatureText),
            new("تناسب اندام و برش", p.FitText),
            new("زمان آماده‌سازی", p.TimeText),
            new("پارچه، ملزومات و گزینه‌ها", p.MaterialsText + " " + ProductFaqFactory.OptionDescription(p)),
        })
    </div>
</section>
        @await Html.PartialAsync("Partials/_FaqSection", (faqHeader, productFaqs, "faq", "py-5"))
@if (Model.Related.Count > 0)
{
    <section class="py-5 section-dark" id="related" aria-labelledby="related-title">
        <div class="container">
            <h2 id="related-title" class="info-section-title d-flex align-items-center gap-3 mb-4">مدل‌های مرتبط</h2>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
                @foreach (var r in Model.Related)
                {
                    <div class="col d-flex reveal-element">
                        <article class="card narsha-card product-list-card h-100 w-100 d-flex flex-row flex-sm-column position-relative">
                            <div class="card-image-wrap">
                                <img src="@r.Image" alt="@r.Alt" class="card-img-top product-list-img img-fluid" width="400" height="533" loading="lazy">
                            </div>
                            <div class="card-body d-flex flex-column flex-grow-1">
                                <h3 class="card-title h5 mb-2"><a href="/@r.Slug" class="stretched-link text-reset text-decoration-none">@r.Title</a></h3>
                                <p class="product-list-desc d-block d-sm-none mb-2">@r.Description</p>
                                <div class="mt-auto">
                                    <p class="price-tag mb-0 py-2 px-3">از @NarshaStaticSite.Models.PriceFormat.Toman(r.BasePrice) تومان</p>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>
    </section>
}
<section class="py-5@(Model.Related.Count > 0 ? "" : " section-dark")" id="cta" aria-labelledby="cta-title">
    <div class="container cta-section text-center mx-auto">
        <h2 id="cta-title" class="section-title mb-3">برای سفارش @p.Title <span class="text-gold">مشاوره بگیرید</span></h2>
        <div class="section-line mx-auto mb-3" aria-hidden="true"></div>
        <p class="cta-section-desc mb-4">تصویر پارچه، سایزها و جزئیات موردنظر خود را ارسال کنید تا شرایط دوخت و برآورد نهایی سفارش بررسی شود.</p>
        <a href="@SiteContact.BaleUrl" target="_blank" rel="noopener noreferrer" class="btn btn-gold px-5">مشاوره در بله <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></a>
    </div>
</section>